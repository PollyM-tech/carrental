{
  "compilerOptions": {
    "allowJs": true,
    "strict": true,
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "target": "ESNext",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "./**/*"
  ],
  "exclude": [
    "./_generated"
  ]
}
