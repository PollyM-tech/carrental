{
  "name": "carrental",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "convex:dev": "convex dev",
    "convex:auth:setup": "node scripts/configure-convex-auth.mjs",
    "test:auth": "node --experimental-strip-types tests/convex-auth.test.mjs && node --experimental-strip-types tests/auth-routing.test.mjs && node --experimental-strip-types tests/customer-bookings.test.mjs",
    "convex:auth:check": "node --env-file=.env.local scripts/check-convex-auth.mjs",
    "convex:network:check": "node --env-file=.env.local scripts/check-convex-network.mjs",
    "test:vehicles": "node --experimental-strip-types tests/vehicles.test.mjs",
    "test:rentals": "node --experimental-strip-types tests/rental-checks.test.mjs",
    "test:workflow": "node tests/workflow-handlers.test.mjs",
    "test:security": "node --experimental-strip-types tests/session-security.test.mjs"
  },
  "dependencies": {
    "@auth/core": "^0.41.1",
    "@convex-dev/auth": "^0.0.96",
    "convex": "^1.48.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
